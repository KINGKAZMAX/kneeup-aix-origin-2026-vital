# Copy to .env AFTER using the hardened serve.py. Literal values, no shell commands.
# Supported explicit adapter: chat_completions; no provider/model is assumed.
AIRFLOW_AI_ADAPTER=
# API base URL, WITHOUT /chat/completions; no query string or embedded credentials.
AIRFLOW_AI_BASE_URL=
AIRFLOW_AI_MODEL=
# bearer (HTTPS + key), or local_no_auth (loopback-only, no key required).
AIRFLOW_AI_AUTH_MODE=
AIRFLOW_AI_API_KEY=
